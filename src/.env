# .env
# Set the absolute path to your local 'src' directory.
# This path is used to mount the source code into the containers.
ADBREW_CODEBASE_PATH=./src 
# Example from your prompt:
# ADBREW_CODEBASE_PATH=E:\Placement\Company\Adbrew\adb_test_harshalbhangale\adb_test_harshalbhangale\src

# --- Django Backend Configuration ---
DJANGO_PORT=8000
# Database connection settings (used in rest/rest/settings.py)
MONGO_HOST=db
MONGO_PORT=27017
MONGO_DB_NAME=adbrew_todo_db
# In a real scenario, you'd add SECRET_KEY and DEBUG=False here

# --- React Frontend Configuration ---
REACT_PORT=3000
# The frontend needs to know where the Django API is running
REACT_APP_API_BASE_URL=http://localhost:8000